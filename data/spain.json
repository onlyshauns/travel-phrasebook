  "culture": [
    {
      "e": "💋",
      "rule": "Cheek-to-cheek kiss as greeting",
      "note": "Two kisses (right cheek first) between friends, even if meeting for the first time. Men often kiss women; men may hug each other."
    },
    {
      "e": "🌙",
      "rule": "Dinner is late — really late",
      "note": "Restaurants fill up after 9pm. Eating before 8pm marks you as a tourist. Clubs don't get busy until 2am."
    },
    {
      "e": "😴",
      "rule": "Siesta is real",
      "note": "Many shops close 2–5pm, especially outside major cities. Plan your shopping around it."
    },
    {
      "e": "🍺",
      "rule": "Tapa with every drink in some cities",
      "note": "In Granada, Seville, and smaller cities, ordering a drink often comes with a free tapa. In Barcelona, it usually doesn't."
    },
    {
      "e": "⚽",
      "rule": "Football allegiances run deep",
      "note": "Real Madrid vs Barça is more than sport — it's political. Read the room before expressing opinions."
    },
    {
      "e": "🗣️",
      "rule": "Speak up — noise is normal",
      "note": "Spanish social culture is lively and loud by Northern European standards. Don't mistake volume for argument."
    }
  ],
  "money": [
    {
      "e": "💳",
      "rule": "Cards widely accepted",
      "note": "Contactless works nearly everywhere in cities. Some rural restaurants and markets are cash-only — carry €20–40."
    },
    {
      "e": "🍽️",
      "rule": "Menú del día is incredible value",
      "note": "A set lunch menu (starter, main, dessert, drink) for €10–15 at local restaurants. Only available at lunchtime."
    },
    {
      "e": "🏬",
      "rule": "VAT refund for non-EU visitors",
      "note": "Claim IVA tax back (21%) at the airport for purchases over €90 at eligible shops. Ask for a 'Tax Free' form."
    },
    {
      "e": "🚫",
      "rule": "Avoid plaza mayor tourist traps",
      "note": "Restaurants on the main plazas charge 2–3x what you'd pay one street back. Walk away from the square."
    },
    {
      "e": "🎯",
      "rule": "Tipping is modest, not mandatory",
      "note": "Round up or leave 5–10% for good service. Leaving nothing is acceptable. American-style 20% tipping is not expected."
    }
  ],
  "food": [
    {
      "e": "🥩",
      "name": "Jamón ibérico",
      "what": "World-class air-cured ham from acorn-fed black pigs — one of Spain's greatest exports",
      "tip": "Splurge on Jamón ibérico de bellota (acorn-fed). Slice thin and eat at room temperature."
    },
    {
      "e": "🥔",
      "name": "Patatas bravas",
      "what": "Fried potato cubes with spicy tomato sauce and/or aioli — the quintessential tapa",
      "tip": "Every bar makes them slightly differently. Finding your favourite version is a worthy quest."
    },
    {
      "e": "🍤",
      "name": "Gambas al ajillo",
      "what": "Prawns sizzled in olive oil with garlic and dried chilli — served in a clay dish",
      "tip": "Mop up every drop of the oil with bread. The best part."
    },
    {
      "e": "🥘",
      "name": "Paella valenciana",
      "what": "Saffron rice with rabbit, chicken, and green beans — the original paella from Valencia",
      "tip": "If a paella is ready in under 20 minutes, it's frozen. Proper paella takes 40+ minutes."
    },
    {
      "e": "🍫",
      "name": "Churros con chocolate",
      "what": "Fried dough sticks dunked in thick, dark hot chocolate — breakfast or late-night snack",
      "tip": "Best at a chocolatería on a cold morning. Not the thin churros — the thick porras version is better."
    },
    {
      "e": "🍷",
      "name": "Rioja / Cava",
      "what": "Spain's world-famous red wine from La Rioja, or Cava sparkling wine from Catalonia",
      "tip": "Order house wine by the glass — quality is high and the price is low. Vermut (vermouth) is the local aperitif."
    }
  ],
  "safety": [
    {
      "e": "🎒",
      "rule": "Pickpockets on Las Ramblas & Gran Vía",
      "note": "Barcelona's Las Ramblas and Madrid's Gran Vía are among Europe's worst for pickpocketing. Use a cross-body bag, zip all pockets."
    },
    {
      "e": "👕",
      "rule": "Distraction scam — 'bird poo'",
      "note": "Someone claims you have something on your jacket and 'helps' clean it while an accomplice goes through your bag. Refuse any contact."
    },
    {
      "e": "🌙",
      "rule": "Drink spiking in clubs",
      "note": "Keep your drink in hand in Ibiza, Magaluf, and Barcelona's tourist clubs. Don't leave drinks unattended."
    },
    {
      "e": "🚗",
      "rule": "Don't leave anything visible in rental cars",
      "note": "Smash-and-grab theft from parked cars is common in tourist areas. Take everything out, even bags from the boot."
    },
    {
      "e": "🌡️",
      "rule": "Summer heat in Andalucía",
      "note": "Temperatures exceed 40°C in Seville, Córdoba, and Granada in July–August. Stay hydrated and avoid midday sun."
    }
  ],
