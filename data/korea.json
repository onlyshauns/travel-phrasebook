  "culture": [
    {
      "e": "🙇",
      "rule": "Bowing is the standard greeting",
      "note": "A slight head nod works for casual interactions. Deeper bows show more respect to elders or seniors."
    },
    {
      "e": "👴",
      "rule": "Age and hierarchy matter",
      "note": "Korea has a strong Confucian culture. Always show deference to older people — let them sit first, pour their drink first."
    },
    {
      "e": "🍶",
      "rule": "Pour drinks for others, not yourself",
      "note": "It's polite to pour for the people around you and let others pour for you. Never fill your own glass."
    },
    {
      "e": "🙌",
      "rule": "Two hands when giving or receiving",
      "note": "Use both hands — or support your right arm with your left — when giving or receiving objects, gifts, or money."
    },
    {
      "e": "💴",
      "rule": "Don't tip",
      "note": "Tipping is not part of Korean culture and can sometimes cause confusion or embarrassment."
    },
    {
      "e": "👟",
      "rule": "Remove shoes at the entrance of homes",
      "note": "Slippers will usually be provided. Always wait for a cue from your host."
    }
  ],
  "money": [
    {
      "e": "💳",
      "rule": "Card accepted almost everywhere",
      "note": "Korea is nearly cashless — cards work at convenience stores, taxis, and most restaurants. Still carry ₩20,000–30,000 for small stalls."
    },
    {
      "e": "🏧",
      "rule": "7-Eleven and GS25 ATMs accept foreign cards",
      "note": "These convenience store ATMs are the most reliable for international cards. Available 24/7 nationwide."
    },
    {
      "e": "🚌",
      "rule": "Load a T-money card",
      "note": "Rechargeable transit card used on all buses, metro, and even some taxis. Saves time and gives a small discount per trip."
    },
    {
      "e": "🙅",
      "rule": "Never tip",
      "note": "Tipping is genuinely not done in Korea. In some contexts it can feel awkward or even insulting — just don't."
    },
    {
      "e": "🛍️",
      "rule": "Tax refund at department stores",
      "note": "Non-Korean visitors can get 10% VAT back on purchases over ₩30,000. Show your passport at checkout."
    }
  ],
  "food": [
    {
      "e": "🥩",
      "name": "Korean BBQ (삼겹살)",
      "what": "Thick-cut pork belly grilled at your table, wrapped in lettuce with garlic and gochujang paste",
      "tip": "The scissors are for cutting meat — let the staff do the first cut if you're new to it."
    },
    {
      "e": "🍲",
      "name": "Bibimbap (비빔밥)",
      "what": "Rice bowl topped with seasoned vegetables, a fried egg, and gochujang — mix everything together before eating",
      "tip": "Order the dolsot (hot stone pot) version for crispy rice at the bottom."
    },
    {
      "e": "🌶️",
      "name": "Tteokbokki (떡볶이)",
      "what": "Chewy rice cakes in a spicy-sweet gochujang sauce — the most popular street food",
      "tip": "Pairs well with a fish cake skewer and a cup of the broth."
    },
    {
      "e": "🥒",
      "name": "Kimchi (김치)",
      "what": "Fermented cabbage with gochugaru, garlic, and ginger — comes free with every Korean meal",
      "tip": "Hundreds of varieties exist. The aged kimchi (geotjeori vs. kimchi) has a deeper, more sour flavour."
    },
    {
      "e": "🍶",
      "name": "Soju (소주)",
      "what": "Korea's beloved clear rice spirit, typically 16–25% ABV — almost always drunk with food",
      "tip": "Never pour your own glass. Always pour for others first and let them pour for you."
    },
    {
      "e": "☕",
      "name": "Korean café culture",
      "what": "Seoul has the highest café density of any city in the world — unique themed cafés everywhere",
      "tip": "Many cafés require you to order at least one drink. Most have beautiful interiors worth a visit."
    }
  ],
  "safety": [
    {
      "e": "🛡️",
      "rule": "Korea is exceptionally safe",
      "note": "It consistently ranks among the world's safest countries for tourists. Violent crime targeting visitors is extremely rare."
    },
