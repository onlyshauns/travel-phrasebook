  "tips": {
    "greetings": "💡 Koreans appreciate when foreigners try Korean. Even a simple 안녕하세요 earns a warm response.",
    "food": "💡 Banchan (side dishes) are free and refillable. Tipping is not customary and can cause awkwardness.",
    "directions": "💡 Seoul's metro is world-class with English signs. Kakao Maps and Naver Maps are more accurate than Google Maps in Korea.",
    "numbers": "💡 Korean has two number systems. These Sino-Korean ones (일이삼) cover most travel needs — money, floors, dates.",
    "emergency": "💡 Police: <strong>112</strong>. Fire & Ambulance: <strong>119</strong>. Tourist helpline (English 24/7): <strong>1330</strong>.",
    "shopping": "Shop prices are fixed. Department stores have tax-refund counters.",
    "medical": "Call 119 for fire and ambulance. Pharmacies are marked with a cross.",
    "immigration": "Have your passport and the address. The English tourist line is 1330.",
    "hotel": "Sort rubbish the way the room card asks. Ask the desk about a transit card.",
    "transport": "T-money works on the subway and on buses. Stand on the marked side of the escalator."
  },
  "pronGuide": {
    "title": "Korean Sounds",
    "tips": [
      "Consonants come in plain / aspirated / tense pairs: ㅂ(b) ㅍ(p) ㅃ(pp)",
      "Each syllable block is one beat — no heavy stress like English",
      "ㄹ is between English L and R — tongue tip behind upper teeth",
      "Vowel ㅓ (eo) sounds like \"uh\" in butter"
    ]
  },
