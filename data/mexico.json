  "culture": [
    {
      "e": "🤝",
      "rule": "Greet everyone",
      "note": "In Mexico it's rude to walk into a room without greeting everyone individually. Take the time."
    },
    {
      "e": "⏰",
      "rule": "Flexible time",
      "note": "\"Ahorita\" can mean now, later, or never. Mexicans are warm hosts but timing is relaxed."
    },
    {
      "e": "🙏",
      "rule": "Religion is important",
      "note": "Lower your voice and dress modestly in churches. Many are active places of worship."
    },
    {
      "e": "🎵",
      "rule": "Mariachi culture",
      "note": "If mariachis play at your table, it's expected to pay them ~100 MXN per song. Enjoy!"
    },
    {
      "e": "🌮",
      "rule": "Food is identity",
      "note": "Complimenting the food is always appreciated. Never say Mexican food is \"just like Taco Bell.\""
    }
  ],
  "money": [
    {
      "e": "💵",
      "rule": "Mix of cash and card",
      "note": "Markets and small restaurants are cash-only. Cards work in hotels and chains. Carry MXN."
    },
    {
      "e": "🏧",
      "rule": "Use bank ATMs",
      "note": "HSBC, Santander, and Banamex ATMs are safest. Avoid standalone machines in tourist areas."
    },
    {
      "e": "💱",
      "rule": "USD widely accepted",
      "note": "Many tourist areas take USD, but pay in MXN to avoid bad exchange rates at the register."
    }
