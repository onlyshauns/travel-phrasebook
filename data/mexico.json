  "food": [
    {
      "e": "🌮",
      "name": "Tacos al Pastor",
      "what": "Marinated pork on a vertical spit, with pineapple",
      "tip": "The pinnacle of Mexico City street food. Order three to start."
    },
    {
      "e": "🫔",
      "name": "Tamales",
      "what": "Masa dough stuffed with meat, wrapped in corn husks",
      "tip": "Sold in the morning from street carts. \"Tamal de rajas\" (cheese and chilli) is vegetarian."
    },
    {
      "e": "🥑",
      "name": "Guacamole",
      "what": "Fresh avocado dip with lime, onion, and chilli",
      "tip": "Order it freshly made tableside at sit-down restaurants."
    },
    {
      "e": "🍜",
      "name": "Pozole",
      "what": "Hominy corn soup with meat — red, white, or green",
      "tip": "A hearty Mexican staple. Perfect on a cold day or after a night out."
    },
    {
      "e": "🧇",
      "name": "Chilaquiles",
      "what": "Fried tortilla strips in salsa with eggs and cream",
      "tip": "The ultimate Mexican breakfast. Order \"rojos\" (red) or \"verdes\" (green)."
    }
  ],
  "safety": [
    {
      "e": "💧",
      "rule": "No tap water",
      "note": "Only drink bottled or filtered water. Avoid salads and fresh juices from unknown vendors."
    },
    {
      "e": "🚕",
      "rule": "Use Uber",
      "note": "Hail Uber over street taxis, especially at night. Never take unofficial cabs from airports."
    },
    {
