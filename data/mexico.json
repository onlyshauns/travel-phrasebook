  "tips": {
    "greetings": "💡 \"Buenos días/tardes/noches\" match the time of day. A handshake is standard; close friends hug and sometimes do a single cheek kiss.",
    "food": "💡 Street tacos are safe and incredible — look for busy stalls with high turnover. Ask \"¿Pica mucho?\" to gauge spice level.",
    "directions": "💡 Uber is available in major cities. Metro in Mexico City is extremely cheap and efficient.",
    "numbers": "💡 Currency is Mexican Peso (MXN, $). Many places accept USD, but change is given in Pesos.",
    "emergency": "💡 Dial 911 (all emergencies). LOCATEL (5658-1111 in CDMX) is a tourist help line.",
    "shopping": "Bargain in markets. Small bills are more useful than large ones.",
    "medical": "Call 911. Drink bottled water.",
    "immigration": "Have your tourist form and the hotel address.",
    "hotel": "Use the safe for your passport. Ask the desk to call a taxi if it is late.",
    "transport": "Use a registered taxi or Uber. Confirm the destination on the map."
  },
  "pronGuide": {
    "title": "Mexican Spanish Sounds",
    "tips": [
      "The letter Ñ makes a \"ny\" sound — España sounds like \"es-PAH-nya\"",
      "LL is pronounced like a Y in Mexico — \"llama\" = YAH-ma",
      "The letter J (and G before E/I) is a strong guttural H sound",
      "Mexican Spanish is generally clear and easy to understand — a great starter for Spanish learners"
    ]
  },
