  "culture": [
    {
      "e": "👗",
      "rule": "Dress modestly, especially at religious sites",
      "note": "Cover knees and shoulders when visiting mosques or temples. Many sites provide sarongs at the entrance."
    },
    {
      "e": "👟",
      "rule": "Remove shoes before entering homes and temples",
      "note": "Always remove footwear at the door. You'll usually see a pile of shoes outside as a signal."
    },
    {
      "e": "🤝",
      "rule": "Use your right hand for eating and greeting",
      "note": "The left hand is considered unclean. Use your right hand to eat, give, and receive things."
    },
    {
      "e": "🧕",
      "rule": "Most restaurants in KL are halal",
      "note": "Pork and alcohol are absent from halal establishments. Look for non-halal or Chinese restaurants if you need them."
    },
    {
      "e": "🛒",
      "rule": "Bargaining is fine in markets, not malls",
      "note": "Night markets and street stalls expect it. Fixed-price shops and malls do not."
    },
    {
      "e": "😊",
      "rule": "Malaysians are warm and helpful",
      "note": "Don't hesitate to ask for help — people will often go out of their way to assist tourists."
    }
  ],
  "money": [
    {
      "e": "💵",
      "rule": "Cash is still king outside KL",
      "note": "Carry RM 50–100 for markets and smaller towns. Cards work well in malls and chain restaurants."
    },
    {
      "e": "🏧",
      "rule": "Use Maybank or CIMB ATMs",
      "note": "These are the most reliable for foreign cards with reasonable fees."
    },
    {
      "e": "🛒",
      "rule": "Bargain at markets, not malls",
      "note": "Pasar malam (night markets) expect negotiation. Start at 60% of asking price and meet in the middle."
    },
    {
      "e": "🍽️",
      "rule": "Service charge already added",
      "note": "Most restaurants add 10% service charge + 6% tax. Tipping on top is not expected."
    },
    {
      "e": "❌",
      "rule": "Decline dynamic currency conversion",
      "note": "Always pay in Ringgit. If asked to pay in your home currency, say no — the rate is always worse."
    }
  ],
  "food": [
    {
      "e": "🍚",
      "name": "Nasi lemak",
      "what": "Coconut rice with sambal, anchovies, peanuts, boiled egg — the national dish, eaten for breakfast",
      "tip": "Best from a humble warung (food stall), not a restaurant."
    },
    {
      "e": "🍜",
      "name": "Char kway teow",
      "what": "Wok-fried flat rice noodles with egg, bean sprouts, prawns and soy sauce",
      "tip": "The best ones have wok hei — that smoky charred flavour from high heat."
    },
    {
      "e": "🫓",
      "name": "Roti canai",
      "what": "Flaky flatbread served with dhal or curry sauce — eaten any time of day",
      "tip": "Tear with your right hand and dip. Order 'roti telur' (with egg) for a heartier version."
    },
    {
      "e": "🍵",
      "name": "Teh tarik",
      "what": "'Pulled tea' — strong sweetened milk tea poured between cups to create a frothy top",
      "tip": "A national ritual. Ask for 'kurang manis' (less sweet) if you prefer."
    },
    {
      "e": "🍢",
      "name": "Satay",
      "what": "Grilled meat skewers served with peanut sauce, cucumber, and rice cakes (ketupat)",
      "tip": "Kajang satay (from Kajang town) is considered the best in Malaysia."
    },
    {
      "e": "👑",
      "name": "Durian",
      "what": "The spiky 'King of Fruits' with a pungent smell and rich custardy flesh",
      "tip": "Banned in many hotels and public transport. Try Musang King variety for the best flavour."
    }
  ],
  "safety": [
    {
      "e": "👜",
      "rule": "Snatch theft on pavement",
      "note": "Walk on the inner side of the pavement (away from traffic), bag on the wall side. Motorbike snatchers grab from the road side."
    },
    {
      "e": "🚗",
      "rule": "Always use Grab, never hail random taxis",
      "note": "Metered taxis frequently overcharge tourists. Grab shows the price upfront."
    },
    {
      "e": "💊",
      "rule": "Drug laws are extremely strict",
      "note": "Possession of even small amounts can lead to long prison sentences. Trafficking carries the death penalty."
    },
    {
      "e": "🌧️",
      "rule": "Check the monsoon season",
      "note": "East coast floods Nov–Mar; West coast (KL, Penang) can flood Oct–Nov. Check before travel."
    },
    {
      "e": "🏖️",
      "rule": "Secure valuables on beaches",
      "note": "Don't leave bags unattended at beach resorts — opportunistic theft is common."
