  "culture": [
    {
      "e": "🤝",
      "rule": "Use your right hand — always",
      "note": "The left hand is considered unclean. Use your right hand to eat, give gifts, money, or shake hands."
    },
    {
      "e": "👗",
      "rule": "Dress modestly, especially in Bali",
      "note": "Cover shoulders and knees at temples. A sash or sarong is often required — and usually provided at the gate."
    },
    {
      "e": "👟",
      "rule": "Remove shoes before entering homes and temples",
      "note": "A pile of shoes outside is the universal signal. Always follow the lead of your hosts."
    },
    {
      "e": "🕌",
      "rule": "Respect prayer times",
      "note": "The call to prayer happens five times a day. Be patient if shops pause briefly — it's usually just a few minutes."
    },
    {
      "e": "☝️",
      "rule": "Point with your thumb, not your finger",
      "note": "Pointing with your index finger is considered rude. Use your right thumb to gesture direction."
    },
    {
      "e": "🛒",
      "rule": "Bargaining is expected in markets",
      "note": "Start at about half the asking price in street markets and work from there. Fixed-price signs mean no negotiation."
    }
  ],
  "money": [
    {
      "e": "💵",
      "rule": "Cash is essential outside Bali/Jakarta",
      "note": "Rural areas, local warungs, and markets are cash only. Always keep Rp 100,000–200,000 on hand."
    },
    {
      "e": "🏧",
      "rule": "BCA and Mandiri ATMs most reliable",
      "note": "These two banks accept foreign cards most consistently. Avoid smaller ATMs in tourist areas — fees are higher."
    },
    {
      "e": "💱",
      "rule": "Watch those zeroes",
      "note": "Rp 1,000 is about $0.06. Rp 500,000 notes are the largest — count your change carefully as the denominations look similar."
    },
    {
      "e": "🛒",
      "rule": "Bargain in markets, not shops",
      "note": "Night markets and craft stalls expect negotiation. Malls and restaurants with printed menus don't. Start at 50% and be friendly."
    },
    {
      "e": "💸",
      "rule": "Visa on arrival fee: Rp 500,000",
      "note": "Payable in cash at the airport — exact change preferred. Some nationalities are exempt. Check before you travel."
    }
  ],
  "food": [
    {
      "e": "🍳",
      "name": "Nasi goreng",
      "what": "Fried rice with sweet soy sauce (kecap manis), egg, and vegetables — Indonesia's national dish",
      "tip": "Available everywhere, any time of day. Order it with a fried egg on top."
    },
    {
      "e": "🍢",
      "name": "Satay (sate)",
      "what": "Grilled skewers of marinated meat served with peanut sauce and lontong (rice cake)",
      "tip": "Sate Madura (from Madura island) is considered the best — often sold by street cart vendors."
    },
    {
      "e": "🥜",
      "name": "Gado-gado",
      "what": "Blanched vegetables with hard-boiled egg in a rich peanut sauce dressing",
      "tip": "A great vegetarian option that's filling and widely available."
    },
    {
      "e": "🥩",
      "name": "Rendang",
      "what": "Slow-cooked beef in coconut milk and spices until dry and intensely flavoured — a Padang specialty",
      "tip": "Best eaten with steamed rice. The Padang restaurant chain (Restoran Padang) is everywhere."
    },
    {
      "e": "🐷",
      "name": "Babi guling (Bali only)",
      "what": "Whole spit-roasted suckling pig stuffed with Balinese spices — a ceremonial dish now widely available",
      "tip": "Not halal — only available in Bali and at non-Muslim establishments. Ibu Oka in Ubud is famous for it."
    },
    {
      "e": "☕",
      "name": "Kopi tubruk",
      "what": "Traditional Indonesian coffee — finely ground beans brewed directly in the cup with hot water",
      "tip": "Wait for the grounds to settle before drinking. Kopi luwak (civet coffee) is a pricey local novelty."
    }
  ],
  "safety": [
    {
      "e": "🛵",
      "rule": "Motorbike rental risks",
      "note": "Ensure you have insurance before renting. Helmets are mandatory and enforced. Check the bike thoroughly for existing damage before riding off."
    },
    {
      "e": "💊",
      "rule": "Drug laws carry severe penalties",
      "note": "Indonesia has some of the world's strictest drug laws. Trafficking can result in the death penalty. Possession carries long jail terms."
    },
    {
      "e": "🏖️",
      "rule": "Secure valuables at beach resorts",
      "note": "Petty theft is common on popular beaches in Bali. Don't leave bags, electronics, or passports unattended."
    },
    {
      "e": "🕌",
      "rule": "Respect religious spaces",
      "note": "Dress modestly near mosques and Hindu temples. Do not enter active ceremonies without invitation. Remove shoes always."
    },
    {
      "e": "🌊",
      "rule": "Bali ocean currents are dangerous",
      "note": "Several beaches have powerful rip currents. Only swim at beaches with lifeguards and flags. Kuta and Seminyak can be treacherous."
    }
  ],
