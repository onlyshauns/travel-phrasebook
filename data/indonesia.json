  "tips": {
    "greetings": "💡 Adding <em>\"Pak\"</em> (older men) or <em>\"Bu\"</em> (older women) after a greeting shows respect.",
    "food": "💡 Nasi goreng (fried rice) and mie goreng (fried noodles) are safe bets anywhere in the country.",
    "directions": "💡 Ojek (motorbike taxis via Gojek or Grab) are fastest through traffic. Always use the app for pricing.",
    "numbers": "💡 \"Dua puluh lima\" = 25 (two tens five). Completely regular and easy to learn.",
    "emergency": "💡 Emergency: <strong>112</strong>. Police: <strong>110</strong>. Ambulance: <strong>118</strong>.",
    "shopping": "Bargain in markets. Mall prices are fixed.",
    "medical": "Call 118 for an ambulance. Drink bottled water.",
    "immigration": "Visa rules change. Check the latest stay length before you fly, and keep your passport.",
    "hotel": "Ask for a fan or repellent if the room has mosquitoes and no net.",
    "transport": "Use Grab or Gojek. Confirm the destination on the map before the bike moves."
  },
  "pronGuide": {
    "title": "Indonesian Sounds",
    "tips": [
      "Mostly phonetic — read it like Spanish",
      "C is always \"ch\" (<em>coba</em> = cho-bah)",
      "NG at the start of a word is valid (like \"singing\")",
      "Stress the second-to-last syllable in most words"
    ]
  },
