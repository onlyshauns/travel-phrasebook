  "tips": {
    "greetings": "💡 \"你好\" (nǐ hǎo) is universal. Add the person's title (老师 teacher, 先生 Mr) to show extra respect.",
    "food": "💡 Menus often have pictures — point confidently. Say \"辣不辣?\" to ask if it's spicy before ordering.",
    "directions": "💡 Subway maps are in English and Chinese. Show your destination written in Chinese characters to taxi drivers.",
    "numbers": "💡 The number 4 is unlucky (sounds like \"death\"). Eight is very lucky. Prices are in Yuan (¥ / RMB).",
    "emergency": "💡 Dial 110 (police), 120 (ambulance), 119 (fire). WeChat and Alipay are essential — carry little cash.",
    "shopping": "Bargain in markets, not in malls. Alipay and WeChat Pay are the usual way to pay.",
    "medical": "Call 120 for an ambulance. International clinics cost more and speak more English.",
    "immigration": "Have the hotel address in Chinese characters on your phone.",
    "hotel": "Check-in often needs the passport itself, not a photo. Ask for the Wi-Fi.",
    "transport": "Metro signs are bilingual in the big cities. Didi is the ride-hail app."
  },
  "pronGuide": {
    "title": "Mandarin Sounds",
    "tips": [
      "Mandarin has four tones — the same syllable means different things at different pitches",
      "X sounds like \"sh\", Q like \"ch\", ZH like a hard \"j\"",
      "Pinyin \"e\" alone is like \"uh\", but \"ei\" is like \"ay\"",
      "The ü sound (written u after j/q/x/y) is like French \"tu\" — round lips and say \"ee\""
    ]
  },
