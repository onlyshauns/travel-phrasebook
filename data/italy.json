  "tips": {
    "greetings": "💡 <em>Ciao</em> is informal — use <em>Buongiorno</em> or <em>Buonasera</em> with strangers and in shops.",
    "food": "💡 <em>Coperto</em> (cover charge, €1–3) is legal and normal — it's in the menu. Service is separate from tipping.",
    "directions": "💡 ZTL zones (restricted traffic areas) in historic centres are camera-enforced. Never drive into them — fines follow you home.",
    "numbers": "💡 Italian numbers are irregular 11–19 then follow a logical pattern. Learn <em>venti</em> (20) and build from there.",
    "emergency": "💡 General emergency: <strong>112</strong>. Police (Carabinieri): <strong>112</strong>. Medical emergency: <strong>118</strong>.",
    "shopping": "Say buongiorno before you browse. Take the receipt with you when you leave.",
    "medical": "Call 112 or 118. A farmacia can help with minor problems.",
    "immigration": "Schengen rules apply. Have the hotel address ready.",
    "hotel": "A city tourist tax is often added at the desk. Ask before you pay.",
    "transport": "Validate a bus ticket in the machine on board. Some trains need a seat reservation."
  },
  "pronGuide": {
    "title": "Italian Sounds",
    "tips": [
      "Mostly phonetic — vowels are pure (A=ah, E=eh, I=ee, O=oh, U=oo)",
      "C before E/I = \"ch\" (ciao, grazie) — before A/O/U = hard K",
      "Double consonants are held longer — <em>penne</em> vs <em>pene</em> is a very different word!",
      "GN = \"ny\" (gnocchi = NYOK-kee), GLI = \"ly\" (famiglia = fah-MEE-lyah)"
    ]
  },
