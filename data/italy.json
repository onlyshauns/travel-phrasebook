  "culture": [
    {
      "e": "☕",
      "rule": "Cappuccino only before noon",
      "note": "Ordering a cappuccino after a meal marks you immediately as a tourist. Espresso is what Italians drink after lunch and dinner."
    },
    {
      "e": "⛪",
      "rule": "Strict dress codes at churches",
      "note": "Cover shoulders and knees at all churches and the Vatican. Many enforce this at the entrance — wraps are often available to rent."
    },
    {
      "e": "🤌",
      "rule": "Gestures are communication",
      "note": "Italians use their hands extensively when speaking — it's warmth, not agitation. Don't be alarmed."
    },
    {
      "e": "🕐",
      "rule": "Kitchens close between lunch and dinner",
      "note": "Most trattorias and restaurants don't serve food from 3–7pm. Aperitivo time (6–8pm) fills the gap."
    },
    {
      "e": "👔",
      "rule": "Use Lei (formal you) with strangers",
      "note": "Using the informal 'tu' with shopkeepers or strangers can come across as rude. 'Lei' is the safe default."
    },
    {
      "e": "🚰",
      "rule": "Nasoni fountains in Rome are drinkable",
      "note": "The street fountains (nasoni) throughout Rome dispense excellent cold drinking water — bring a refillable bottle."
    }
  ],
  "money": [
    {
      "e": "💶",
      "rule": "Coperto is legal — not a scam",
      "note": "The cover charge (€1–3 per person) is printed in the menu and legally required to be disclosed. It's not a tip."
    },
    {
      "e": "💵",
      "rule": "Cash-only at many trattorias",
      "note": "Smaller family-run restaurants outside tourist centres often don't take cards. Carry €30–50 cash."
    },
    {
      "e": "🚫",
      "rule": "Avoid piazza restaurants",
      "note": "Restaurants on famous squares (Campo de' Fiori, Piazza Navona) are tourist traps — same food, double the price. Walk one block away."
    },
    {
      "e": "💧",
      "rule": "Acqua naturale o frizzante?",
      "note": "Always specify: naturale (still) or frizzante (sparkling). Tap water (acqua del rubinetto) is free if you ask."
    },
    {
      "e": "🎯",
      "rule": "Tipping is not expected",
      "note": "Round up or leave small change if happy. 5–10% for exceptional service. Never feel obligated."
    }
  ],
  "food": [
    {
      "e": "🍝",
      "name": "Cacio e pepe",
      "what": "Rome's simplest and greatest pasta — just Pecorino cheese and black pepper, nothing else",
      "tip": "Only order this in Rome. Anywhere else it's likely pre-made. The best versions have a silky, emulsified sauce."
    },
    {
      "e": "🍕",
      "name": "Pizza Napoletana",
      "what": "Soft, chewy, slightly charred at the edges — wet in the centre by design. Only from Naples.",
      "tip": "The thick, pillowy Neapolitan style is the original. Tonda Romana (thin and crispy) is Rome's version."
    },
    {
      "e": "🍨",
      "name": "Gelato",
      "what": "Italy's dense, slow-churned ice cream — far less air than regular ice cream",
      "tip": "Avoid gelato in bright mounds or plastic tubs — look for metal containers with lids (pastoso style). Price reflects quality."
    },
    {
      "e": "🍊",
      "name": "Aperitivo (Spritz)",
      "what": "Campari or Aperol with prosecco and soda — Italy's pre-dinner ritual, often with free bar snacks",
      "tip": "Best watched at sunset in Venice or at a bar in Milan's Brera district. Aperitivo hour is 6–8pm."
    },
    {
      "e": "🥩",
      "name": "Bistecca alla Fiorentina",
      "what": "Thick-cut T-bone steak from Chianina cattle, grilled rare — a Florentine institution",
      "tip": "Priced by the kilo (usually 800g–1.2kg). Order 'al sangue' (rare) — it's the only proper way."
    },
    {
      "e": "🍞",
      "name": "Supplì (Rome) / Arancini (Sicily)",
      "what": "Fried rice balls filled with ragù and mozzarella — perfect street food",
      "tip": "In Rome: supplì al telefono (the cheese stretches like a phone cord). In Sicily: arancini (cone-shaped, larger)."
    }
  ],
  "safety": [
    {
      "e": "🎒",
      "rule": "Colosseum and Vatican area pickpockets",
      "note": "Extremely active around major tourist sites. Use a cross-body bag, keep phones in front pockets, and stay alert in crowds."
    },
    {
      "e": "🌸",
      "rule": "The rose scam",
      "note": "Someone places a rose in your hand or on your partner — then aggressively demands payment. Drop it and walk away."
    },
    {
      "e": "🚕",
      "rule": "Agree on taxi price before getting in",
      "note": "Especially from airports and train stations. Official taxis have set rates to city centre — insist on the meter or confirm the fixed rate."
    },
    {
      "e": "🚗",
      "rule": "ZTL fines are automatic",
      "note": "Historic centres have camera-enforced restricted zones. If you drive in with a rental car, fines arrive weeks later — often €100+."
    },
    {
      "e": "🛍️",
      "rule": "Buying fake goods is illegal",
      "note": "Purchasing counterfeit bags or goods from street sellers is illegal in Italy — tourists have been fined on the spot."
    }
  ],
