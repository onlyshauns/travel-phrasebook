  "tips": {
    "greetings": "💡 Germans value directness — \"Guten Tag\" in a shop before speaking is polite. Small talk is less common than in southern Europe.",
    "food": "💡 Most restaurants add Trinkgeld (tip) expectations of 5–10%. Give cash directly to the server — don't leave it on the table.",
    "directions": "💡 Germany's train system (Deutsche Bahn) is excellent but notoriously delayed. Always build buffer time for connections.",
    "numbers": "💡 Germans write 1 with a serif (looks like 7 to some). A slash through 7 distinguishes it. Ask if unsure.",
    "emergency": "💡 General emergency: <strong>112</strong>. Police: <strong>110</strong>.",
    "shopping": "Most shops are closed on Sundays. Cards work almost everywhere.",
    "medical": "Call 112. A pharmacy is marked with a red A.",
    "immigration": "Schengen rules apply. Have your passport and the address.",
    "hotel": "Quiet hours are taken seriously. Confirm whether breakfast is included.",
    "transport": "Buy a ticket before you board the U-Bahn or a bus. Inspectors fine you on the spot."
  },
  "pronGuide": {
    "title": "German Sounds",
    "tips": [
      "W = \"v\" (Wasser = VASS-er), V = \"f\" (Vater = FAH-ter)",
      "CH after A/O/U is throaty (Bach), after E/I it's soft (ich)",
      "Ü = purse your lips and say \"ee\"; Ö = round lips and say \"eh\"",
      "Final voiced consonants go unvoiced — B→P, D→T, G→K"
    ]
  },
