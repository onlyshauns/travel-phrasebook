  "culture": [
    {
      "e": "⏰",
      "rule": "Punctuality is non-negotiable",
      "note": "Being on time is not polite — it is the minimum expectation. Being 5 minutes late requires a brief apology."
    },
    {
      "e": "🗣️",
      "rule": "Directness is a virtue, not rudeness",
      "note": "Germans say exactly what they mean. Don't mistake bluntness for unfriendliness — it's genuine and they prefer it."
    },
    {
      "e": "🛍️",
      "rule": "Almost everything is closed on Sundays",
      "note": "Sunday is legally protected rest time. Stock up on groceries Saturday. Petrol stations and some bakeries remain open."
    },
    {
      "e": "♻️",
      "rule": "Recycling is serious",
      "note": "Separate your waste into paper, plastic, bio, and glass. The Pfand (deposit) bottle system means you return bottles to the supermarket."
    },
    {
      "e": "👁️",
      "rule": "Eye contact when toasting",
      "note": "Hold eye contact with every person when clinking glasses. Breaking eye contact during a toast is considered bad luck."
    },
    {
      "e": "🚴",
      "rule": "Respect the cycle lane",
      "note": "Cycling lanes are often next to the pavement and not always clearly marked. Walking in them will earn you an angry bell."
    }
  ],
  "money": [
    {
      "e": "💵",
      "rule": "Germany is more cash-oriented than expected",
      "note": "Many restaurants, cafés, and smaller shops don't accept cards. Carry €30–50 cash, especially outside major cities."
    },
    {
      "e": "💳",
      "rule": "EC (Girocard) is preferred over Visa/Mastercard",
      "note": "German debit cards work on a different network. Your foreign Visa/Mastercard should still work at most terminals — but not always."
    },
    {
      "e": "🍺",
      "rule": "Tip directly to the server in cash",
      "note": "Say the amount you want to pay (e.g., 'Achtzehn Euro' for an €16 bill + €2 tip). Don't leave cash on the table after you've left."
    },
    {
      "e": "🔄",
      "rule": "Pfand — bottle deposit is real",
      "note": "Pay a deposit (€0.08–0.25) on plastic/glass bottles. Return them at supermarket machines for credit. Locals do it religiously."
    },
    {
      "e": "☀️",
      "rule": "Plan shopping around Sunday",
      "note": "Shops are legally required to close on Sundays. Plan grocery shopping for Saturday or use petrol station shops in emergencies."
    }
