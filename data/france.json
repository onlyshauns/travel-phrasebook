  "safety": [
    {
      "e": "📋",
      "rule": "Petition scam",
      "note": "Someone asks you to sign a petition for a charity, then demands a donation. Walk away — it's always a scam."
    },
    {
      "e": "💍",
      "rule": "Gold ring scam",
      "note": "'Did you drop this ring?' They claim to have found it and pressure you to buy it. Ignore and keep walking."
    },
    {
      "e": "🚔",
      "rule": "Fake plainclothes police",
      "note": "Someone flashes a badge and asks to inspect your wallet or passport. Real police don't do this — refuse and walk to a public place."
    },
