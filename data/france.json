  "tips": {
    "greetings": "💡 <strong>Always say Bonjour</strong> when entering any shop, café, or restaurant — and <em>Au revoir</em> when you leave. It's the #1 cultural rule.",
    "food": "💡 The bill won't come unless you ask. Say <em>\"L'addition, s'il vous plaît\"</em> and make eye contact — don't wave or call out.",
    "directions": "💡 Start with <em>\"Excusez-moi\"</em> and try a little French before switching to English — it goes a long way.",
    "numbers": "💡 After 60, French gets quirky — 70 is <em>\"soixante-dix\"</em> (sixty-ten), 80 is <em>\"quatre-vingts\"</em> (four-twenties).",
    "emergency": "💡 Emergency: <strong>112</strong>. Police: <strong>17</strong>. Ambulance (SAMU): <strong>15</strong>.",
    "shopping": "Say Bonjour before you ask a price. Keep the receipt if you want a VAT refund at the airport.",
    "medical": "Pharmacies with a green cross handle minor illness. For an emergency, call 15 or 112.",
    "immigration": "Have your passport and hotel address ready. Many visitors can stay 90 days in the Schengen area.",
    "hotel": "Breakfast is often extra. Ask for the Wi-Fi password and the checkout time at the desk.",
    "transport": "Validate a metro ticket before you board. In a taxi, use the meter or book Bolt."
  },
  "pronGuide": {
    "title": "French Sounds",
    "tips": [
      "Silent letters everywhere — <em>bonjour</em> is bon-ZHOOR, the R is a soft throat sound",
      "Nasal vowels: AN, ON, IN — let air flow through your nose",
      "Stress always falls on the last syllable of a word",
      "The U (as in <em>tu</em>) is not like any English vowel — round lips and say \"ee\""
    ]
  },
