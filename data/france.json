  "culture": [
    {
      "e": "🗣️",
      "rule": "Always greet before you speak",
      "note": "Bonjour before any request in a shop, café, or pharmacy. Skipping it is genuinely considered rude — not just impolite."
    },
    {
      "e": "🍽️",
      "rule": "Ask for the bill — it won't come to you",
      "note": "Meals are leisurely by design. Flag the waiter and say l'addition — waving or snapping fingers is an insult."
    },
    {
      "e": "💶",
      "rule": "Tipping is optional, not expected",
      "note": "Service is already included in the bill. Rounding up €1–2 is perfectly generous."
    },
    {
      "e": "🤫",
      "rule": "Keep your voice down in public",
      "note": "Loud conversations in cafés or on the metro mark you immediately as a tourist."
    },
    {
      "e": "🥖",
      "rule": "Bread goes on the table, not a plate",
      "note": "Place it directly on the tablecloth. Don't ask for butter — it's not typically offered with meals."
    },
    {
      "e": "🚶",
      "rule": "Don't eat while walking",
      "note": "Eating on the go is considered uncivilised. Sit down, even at a café terrace."
    },
    {
      "e": "👗",
      "rule": "Dress up a little",
      "note": "Parisians tend to dress with intention. Smart-casual goes a long way in restaurants and galleries."
    }
  ],
  "money": [
    {
      "e": "💳",
      "rule": "Card accepted almost everywhere",
      "note": "Contactless is the norm. Keep €20–50 cash for markets and small village shops."
    },
    {
      "e": "🏧",
      "rule": "Use bank ATMs, not airport kiosks",
      "note": "Travelex and airport machines charge excessive fees. Find a regular bank ATM."
    },
    {
      "e": "🤑",
      "rule": "Tipping is optional",
      "note": "Service is legally included. Rounding up €1–2 for good service is generous — Americans sometimes over-tip which can feel awkward."
    },
    {
      "e": "❌",
      "rule": "Decline dynamic currency conversion",
      "note": "Always pay in euros when asked 'euros or your home currency?' — your bank rate is better."
    },
    {
      "e": "🧾",
      "rule": "Keep receipts from shops",
      "note": "Required for tax-free VAT refund at the airport if you're a non-EU visitor."
    }
  ],
  "food": [
