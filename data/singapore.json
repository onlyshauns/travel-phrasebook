  "tips": {
    "greetings": "Plain English is enough. \"You eat already?\" is a warm hello, not a question you have to answer.",
    "food": "Hawker centres are the everyday meal. Point at the dish if the stall is loud. \"Tapau\" means takeaway.",
    "directions": "MRT announcements are in English. Say the station name, or book a Grab.",
    "numbers": "Prices are in Singapore dollars. Hawker food often starts around a few dollars. Small change still helps.",
    "emergency": "Call 999 for the police and 995 for fire and ambulance.",
    "shopping": "Prices in malls are fixed. Ask \"any discount?\" only at a market stall.",
    "medical": "Tap water is safe. Clinics and pharmacies are easy to find. Call 995 for an ambulance.",
    "immigration": "Have your passport and the hotel address. Many visitors can enter without a visa for a short stay.",
    "hotel": "Chewing gum is restricted. Ask the desk for the Wi-Fi and the MRT exit.",
    "transport": "Use the MRT and buses. A stored-value card covers both. Grab is the ride-hail app."
  },
  "pronGuide": {
    "title": "Singlish",
    "tips": [
      "English is the language to use. People understand plain English.",
      "Lah, leh, and meh can sit at the end of a sentence. You do not need them.",
      "\"Can or not?\" means \"Is this possible?\" \"Can\" on its own means yes.",
      "\"Tapau\" means takeaway. \"Shiok\" means delicious or great."
    ]
  },
