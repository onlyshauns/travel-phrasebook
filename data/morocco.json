  "culture": [
    {
      "e": "🫖",
      "rule": "Mint tea ritual",
      "note": "Moroccan mint tea (atay) is poured from a height — both for show and to cool it. Never refuse the first glass."
    },
    {
      "e": "🤝",
      "rule": "Right hand greetings",
      "note": "Handshake with the right hand, then touch your hand to your heart. This shows sincerity."
    },
    {
      "e": "👗",
      "rule": "Dress modestly",
      "note": "Cover shoulders and knees, especially in medinas and mosques. Women should carry a scarf."
    },
    {
      "e": "💰",
      "rule": "Bargaining is culture",
      "note": "In souks, the first price is always negotiable. Counter with 30–40% — it's expected and fun."
    },
    {
      "e": "🕌",
      "rule": "Mosques and non-Muslims",
      "note": "Most Moroccan mosques are closed to non-Muslims. The Hassan II mosque in Casablanca is an exception."
    }
  ],
  "money": [
    {
      "e": "💵",
      "rule": "Cash is king",
      "note": "Souks, small riads, and local restaurants are cash-only. Carry MAD in small denominations."
    },
    {
      "e": "🏧",
      "rule": "Withdraw in cities",
      "note": "ATMs are reliable in Marrakech, Casablanca, and Fes. Avoid exchanging money on the street."
    },
    {
      "e": "🤝",
      "rule": "Tip generously",
      "note": "10–15 MAD for guides, porters, and henna artists. Tipping is expected and forms part of their income."
    }
  ],
  "food": [
    {
      "e": "🫕",
      "name": "Tagine",
      "what": "Slow-cooked stew in a conical clay pot — lamb, chicken, or vegetables",
      "tip": "Order at a local restaurant, not tourist spots. Ask for \"beld\" (traditional/local-style)."
    },
    {
      "e": "🥘",
      "name": "Couscous",
      "what": "Semolina grains steamed over broth with vegetables and meat",
      "tip": "Traditionally served on Fridays. Eating couscous with family is a Moroccan ritual."
    },
    {
      "e": "🥗",
      "name": "Zaalouk",
      "what": "Smoky aubergine and tomato salad",
      "tip": "Served as a cold starter. Scoop with bread. Also try taktouka (roasted pepper version)."
    },
    {
      "e": "🧇",
      "name": "Msemen",
      "what": "Square flaky flatbread, often with honey or argan oil",
      "tip": "A Moroccan breakfast staple. Pair with mint tea for the full experience."
    },
    {
      "e": "🥜",
      "name": "Bastilla",
      "what": "Savoury-sweet pie with pigeon (or chicken), almonds, and cinnamon",
      "tip": "A Fes speciality. One of Morocco's most complex, impressive dishes."
    }
  ],
  "safety": [
    {
      "e": "🧭",
      "rule": "Medina navigation",
      "note": "Medina alleys are a labyrinth — use Google Maps offline. Guides offering help may want a tip."
    },
    {
      "e": "🚕",
      "rule": "Official taxis only",
      "note": "Use licensed petit taxis (metered) or agree a price up front. Avoid unmarked \"taxis.\""
    },
    {
      "e": "👁️",
      "rule": "Henna and argan scams",
      "note": "Free henna or argan oil \"samples\" come with aggressive sales. Politely decline if not interested."
    },
    {
      "e": "👗",
      "rule": "Dress for context",
      "note": "Revealing clothing can attract unwanted attention in medinas. Light, modest layers work best."
    }
  ],
