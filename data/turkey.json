  "culture": [
    {
      "e": "🫖",
      "rule": "Çay culture",
      "note": "Tea (çay) is the social glue of Turkey. Declining tea multiple times may be seen as rude — accept it!"
    },
    {
      "e": "🕌",
      "rule": "Mosque etiquette",
      "note": "Remove shoes, cover heads (women) and shoulders. Be quiet and avoid visiting during prayer times."
    },
    {
      "e": "🤝",
      "rule": "Warm hospitality",
      "note": "Turks are exceptionally hospitable. Shop owners may offer tea — it's social, not pressure to buy."
    },
    {
      "e": "🛍️",
      "rule": "Bazaar bargaining",
      "note": "Haggling is expected at the Grand Bazaar and Spice Bazaar. Start at 50–60% of asking price."
    },
    {
      "e": "👁️",
      "rule": "Evil eye (Nazar)",
      "note": "The blue eye symbol (nazar) wards off bad luck. Giving one as a gift is very welcome."
    }
  ],
  "money": [
    {
      "e": "💵",
      "rule": "Carry lira",
      "note": "Bazaars and smaller restaurants prefer Turkish Lira. Some accept EUR/USD but at poor rates."
    },
    {
      "e": "🏧",
      "rule": "ATMs everywhere",
