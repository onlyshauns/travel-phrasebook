  "food": [
    {
      "e": "🥙",
      "name": "Döner Kebap",
      "what": "Rotisserie-grilled meat shaved into bread or on a plate",
      "tip": "The most iconic Turkish street food. Ask for \"dürüm\" (wrap) for the full experience."
    },
    {
      "e": "🫓",
      "name": "Simit",
      "what": "Sesame-crusted bread ring — Turkey's breakfast staple",
      "tip": "Sold by street carts for ~5₺. Best eaten warm with fresh white cheese."
    },
    {
      "e": "🍆",
      "name": "Imam Bayıldı",
      "what": "Stuffed aubergine in olive oil and tomatoes",
      "tip": "A classic Turkish vegetable dish — the name means \"the imam fainted\" (from pleasure)."
    },
    {
      "e": "🥘",
      "name": "Mercimek Çorbası",
      "what": "Red lentil soup",
      "tip": "A Turkish staple, served with lemon and dried mint. Perfect cheap, warming meal."
    },
    {
      "e": "🍬",
      "name": "Turkish Delight (Lokum)",
      "what": "Starch-based confection in dozens of flavours",
      "tip": "Buy from the Spice Bazaar, not tourist shops. Rose and pomegranate are classics."
    }
  ],
  "safety": [
    {
      "e": "✅",
      "rule": "Generally safe",
      "note": "Tourist areas in Istanbul and Cappadocia are safe. Stay aware as in any major city."
    },
    {
      "e": "💧",
      "rule": "No tap water",
      "note": "Tap water is not potable — always drink bottled. Ice in restaurants is usually purified."
    },
    {
      "e": "🚕",
      "rule": "Use metered taxis",
      "note": "Insist the meter is running. BiTaksi (app) is the safest way to book official taxis."
